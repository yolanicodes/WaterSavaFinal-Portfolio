<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminSite.master.cs" Inherits="WaterSavaFinal.AdminSite" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <link href="Content/CustomStylesheet.css" rel="stylesheet" type="text/css" />
   <%-- <link rel="stylesheet" href="Content/bootstrap.min.css" />--%>
    <%--<webopt:BundleReference runat="server" Path="~/Content/css" />--%>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar">
            <img src="Images/waterSava Logo.png" alt="Logo" />   
            <h2 id="navTitle">WaterSava <a href="IndexResidents.aspx"></a></h2>

            <ul id="nav-links" class="nav-links nav-links.active">
            <li><asp:HyperLink ID="ManagePropertiesLink" runat="server" NavigateUrl="~/ManageProperties.aspx">Manage Properties</asp:HyperLink></li>
            <li><asp:HyperLink ID="TrackLink" runat="server" NavigateUrl="~/AdminHouseTrack.aspx">Track properties</asp:HyperLink></li>
            <li><asp:HyperLink ID="detailsLink" runat="server" NavigateUrl="~/ManagePersonalDetails.aspx">Manage Personal Details</asp:HyperLink></li>
                <li><asp:LinkButton ID="logOut" runat="server" OnClick="logOut_Click">Logout</asp:LinkButton></li>
              </ul>
                <div class="menu-icon" onclick="toggleMenu()">
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
</div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                 <p>&copy;<%= DateTime.Now.Year %> - watersava.com</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script src="Scripts/customJavaScript.js" type="text/javascript"></script>
     <script src="Scripts/customScript.js"  type="text/javascript"></script> 
    <script src="Scripts/jquery-3.7.1.min.js"></script>
    <script src="Scripts/bootstrap.bundle.min.js"></script>
</body>
</html>
